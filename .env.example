# Optional. Without any key the agent runs fully offline (deterministic reasoning).
# Selection: --provider flag > LLM_PROVIDER > first provider below with a key set.
# LLM_PROVIDER=none           # none | anthropic | openai | gemini | openrouter | ollama

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Local Ollama needs no key: python chat_cli.py --provider ollama --model <a model that supports tools>
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384
# OLLAMA_API_KEY=             # only for Ollama cloud
